APP_NAME=Literature Review System
DEBUG=true
# Production: set DEBUG=false and provide a long random SECRET_KEY.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/lit_review

SEARCH_PROVIDER_MODE=crossref
FRONTEND_ORIGIN=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=

# Optional Phase 2 LLM augmentation. Safe defaults: disabled, mock provider, no network calls.
LLM_ENABLED=false
LLM_PROVIDER=mock
LLM_MODEL=mock-literature-review-v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=8
LLM_TEMPERATURE=0
LLM_QUERY_REWRITE_ENABLED=false
LLM_RERANK_ENABLED=false
LLM_SUMMARY_ENABLED=false
LLM_MAX_CANDIDATES_FOR_RERANK=10
LLM_MAX_CANDIDATES_FOR_SUMMARY=3
LLM_MAX_SUMMARIES_PER_SEARCH=3
# Production memory-safe recommendation for small Railway instances.
LLM_MAX_INPUT_CHARS_PER_CALL=8000

ELSEVIER_API_KEY=your_elsevier_api_key_here
OPENALEX_API_KEY=your_openalex_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Phase 4 Local Reranker — cross-encoder inference
# Provider options: mock (default, no ML deps), local (requires sentence-transformers)
LOCAL_RERANKER_ENABLED=true
LOCAL_RERANKER_PROVIDER=mock
LOCAL_RERANKER_MODEL_PATH=ml/models/reranker-v1
LOCAL_RERANKER_MODEL_VERSION=v1
LOCAL_RERANKER_TOP_K=20

# Optional production search reranker. Safe default: disabled.
RERANKER_ENABLED=true
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MAX_CANDIDATES=50
RERANKER_BATCH_SIZE=16
RERANKER_TIMEOUT_SECONDS=20
RERANKER_SCORE_WEIGHT=0.35

# Local extractive analysis for search results
LOCAL_ANALYSIS_ENABLED=true
